#lesson(
	(chara.严佩,[
		（进教室）怎么有股臭味啊？（靠近第一排正在大块朵颐的学生）螺蛳粉？
	]),
	(chara.史绅,[
		（咽下口中的粉）老师你来点不？
	]),
	(chara.严佩,[
		（后退一步）你给我出去！
	]),
	(chara.史绅,[
		不吃就算了嘛，真是的。赶人干什么……
	]),
	(chara.严佩,[
		那你倒是看一看，自己身边一圈位置上有坐一个人吗？都形成结界了。同学不好意思说你，你自己没数吗？赶紧出去，不准在教室里吃螺蛳粉。
	]),
	(chara.史绅,[
		（端着螺蛳粉走出教室）
	]),
	[
		严老师打开窗户，惬意地呼吸着清爽的穿堂风。
	],
	(chara.温舒,[
		严老师？打扰一下，有同学问，能不能开一下教室的后门。
	]),
	(chara.严佩,[
		不行，有需要走前门。/*因为之前有个同学大摇大摆地从后门走出教室*/
	]),
	(chara.温舒,[
		但是，门外有个同学在吃螺蛳粉……
	]),
	(chara.严佩,[
		……那打开吧。
	]),
)
